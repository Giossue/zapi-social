{
  "name": "zapi-v2",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "test:e2e:web": "bun run build && bun run --cwd apps/web test:e2e",
    "audit:portal-admin-ui": "python3 scripts/audit_portal_admin_ui.py",
    "audit:i18n": "python3 scripts/audit_i18n_messages.py",
    "audit:i18n-hardcoded": "python3 scripts/audit_i18n_hardcoded.py",
    "audit:schema": "python3 scripts/audit_schema_usage.py",
    "release:codecanyon": "bash scripts/build-codecanyon-release.sh",
    "strip:comments": "bun scripts/strip_comments.ts"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "fast-uri": "4.1.3",
    "js-yaml": "3.15.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.10.11",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "esbuild": "0.25.12",
    "fast-uri": "4.1.3",
    "find-my-way": "9.7.0",
    "hono": "4.13.4",
    "js-yaml": "3.15.1",
    "nanoid": "3.3.18"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
