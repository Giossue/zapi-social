# Copy this file to .env before the first start.
# Generate every CHANGE_ME value independently; never reuse production secrets.
# Use `openssl rand -hex 32` for passwords/JWT and `openssl rand -base64 32`
# for PROVIDER_INTEGRATIONS_ENCRYPTION_KEY.

COMPOSE_PROJECT_NAME=zapi-v2
ZAPI_VERSION=local

POSTGRES_DB=zapi_v2
POSTGRES_USER=zapi
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_A_RANDOM_HEX_SECRET
REDIS_PASSWORD=CHANGE_ME_GENERATE_ANOTHER_RANDOM_HEX_SECRET

JWT_ACCESS_SECRET=CHANGE_ME_GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
PROVIDER_INTEGRATIONS_ENCRYPTION_KEY=CHANGE_ME_GENERATE_EXACTLY_32_BYTES_AS_BASE64

WEB_PUBLIC_PORT=3000
API_PUBLIC_PORT=3001
WEB_ORIGIN=http://localhost:3000
API_PUBLIC_ORIGIN=http://localhost:3001

COOKIE_SECURE=false
DEMO_MODE=false
# Only required while running seed:demo against a prepared demo installation.
# DEMO_OWNER_EMAIL=owner@example.com
# COOKIE_DOMAIN=.example.com
LOG_LEVEL=info

# Optional online media providers. Leave commented when unused.
# UNSPLASH_ACCESS_KEY=
# PEXELS_API_KEY=

# One-time bootstrap credentials. Only export these while running seed:users;
# do not leave passwords in .env after the command succeeds.
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_DISPLAY_NAME=Platform Admin
# SEED_MEMBER_EMAIL=owner@example.com
# SEED_MEMBER_PASSWORD=
# SEED_MEMBER_DISPLAY_NAME=Workspace Owner
# SEED_MEMBER_ROLE=owner
